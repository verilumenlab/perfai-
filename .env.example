# Database configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Admin Authentication & CSRF Secrets (rotate/set in production)
ADMIN_SESSION_SECRET="perfai-super-secret-session-key-change-in-production-2026"
CSRF_SECRET="perfai-super-secret-csrf-key-change-in-production-2026"

# Reverse Proxy Security (set to true only when running behind trusted reverse proxy like Cloudflare/Vercel)
TRUST_PROXY="false"

# Production Base URL
NEXT_PUBLIC_SITE_URL="https://perfai.in"

# CLI Admin Provisioning (optional alternative to interactive hidden prompt, min 12 characters)
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""

# Notification Dispatch (Resend or mock)
# RESEND_API_KEY=""
# NOTIFICATION_RECIPIENT_EMAIL="leads@perfai.in"
# NOTIFICATION_SENDER_EMAIL="PerfAI Leads <no-reply@perfai.in>"

# External CRM Webhook (optional)
# CRM_WEBHOOK_URL=""
# CRM_API_BEARER_TOKEN=""

# Cloudflare Turnstile Anti-Spam (optional)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Distributed Rate Limiting (optional Redis/Upstash connection for multi-instance production)
# REDIS_URL=""
